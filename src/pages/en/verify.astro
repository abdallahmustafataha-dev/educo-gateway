---
import AuthLayout from '../../layouts/AuthLayout.astro';
import { getDictionary } from '../../lib/copy';

const locale = 'en' as const;
const t = getDictionary(locale);
---
<AuthLayout locale={locale} title={`${t['auth.verifyTitle']} — EduCo.`} description={t['meta.description']}>
  <section class="auth-main">
    <div class="container auth-shell">
      <div class="auth-card">
        <a class="auth-brand" href={`/${locale}/`} aria-label={t['brand.home']}>
          <span class="brand__mark"><img data-logo data-light="/educo-light.svg" data-dark="/educo-dark.svg" src="/educo-light.svg" width="36" height="36" alt="" /></span>
          <span class="brand__word">EduCo<span>.</span></span>
        </a>
        <div class="auth-heading">
          <span class="eyebrow">EDUID VERIFICATION</span>
          <h1>{t['auth.verifyTitle']}</h1>
          <p>{t['auth.unverifiedSub']}</p>
        </div>
        <div class="message-region" id="message" aria-live="polite">
          <div class="alert alert--info">{t['auth.verifyChecking']}</div>
        </div>
        <div class="resend-panel" id="resend-panel" hidden>
          <label for="resend-email">{t['auth.email']}</label>
          <div class="resend-panel__row">
            <input id="resend-email" type="email" autocomplete="email" />
            <button class="btn btn--secondary" id="resend-button" type="button">{t['auth.resend']}</button>
          </div>
        </div>
        <a class="auth-footer-link" href={`/${locale}/login/`}>{t['auth.backLogin']}</a>
      </div>
    </div>
  </section>
</AuthLayout>

<script type="module">
  import { authErrorMessage, localeFromDocument, resendSignup } from '../../lib/auth-ui.ts';
  import { setButtonBusy, setMessage } from '../../lib/site.ts';
  import { supabase } from '../../lib/supabase.ts';

  const locale = localeFromDocument();
  const message = document.querySelector('#message');
  const resendPanel = document.querySelector('#resend-panel');
  const resendEmail = document.querySelector('#resend-email');
  const resendButton = document.querySelector('#resend-button');
  const params = new URLSearchParams(window.location.search);
  const hashParams = new URLSearchParams(window.location.hash.replace(/^#/, ''));
  const code = params.get('code') || hashParams.get('code');
  const tokenHash = params.get('token_hash') || params.get('token') || hashParams.get('token_hash') || hashParams.get('token');
  const otpType = params.get('type') || hashParams.get('type') || 'signup';
  const flowId = params.get('sb_flow_id') || hashParams.get('sb_flow_id');
  const errorDescription = params.get('error_description') || hashParams.get('error_description');

  const clearAuthParams = () => {
    const url = new URL(window.location.href);
    ['code', 'token_hash', 'token', 'type', 'sb_flow_id', 'error', 'error_code', 'error_description'].forEach((name) => url.searchParams.delete(name));
    url.hash = '';
    window.history.replaceState({}, '', url.toString());
  };

  const showLinkProblem = () => {
    if (resendPanel) resendPanel.hidden = false;
    setMessage(message, errorDescription ? 'This link is invalid or has expired.' : 'Open the confirmation link from your email to continue.', 'error');
  };

  const verify = async () => {
    if (params.get('reason') === 'unconfirmed') {
      if (resendPanel) resendPanel.hidden = false;
      setMessage(message, 'Your email is not confirmed yet.', 'error');
      return;
    }
    if (errorDescription) {
      showLinkProblem();
      return;
    }
    try {
      const { data: initialSession } = await supabase.auth.getSession();
      if (tokenHash) {
        const { error } = await supabase.auth.verifyOtp({ token_hash: tokenHash, type: otpType as 'signup' | 'invite' | 'magiclink' | 'recovery' | 'email_change' | 'email' });
        if (error) throw error;
      } else if (code && !initialSession.session) {
        const { error } = await supabase.auth.exchangeCodeForSession(code, flowId ? { flowId } : undefined);
        if (error) throw error;
      } else if (!code && !tokenHash && !initialSession.session) {
        showLinkProblem();
        return;
      }
      const { data } = await supabase.auth.getUser();
      if (!data.user?.email_confirmed_at) {
        showLinkProblem();
        return;
      }
      clearAuthParams();
      setMessage(message, 'Your EduID is ready. Taking you to your apps…', 'success');
      window.setTimeout(() => window.location.replace(`/${locale}/apps/`), 900);
    } catch (error) {
      if (resendPanel) resendPanel.hidden = false;
      setMessage(message, authErrorMessage(error, locale));
    }
  };

  resendButton?.addEventListener('click', () => {
    if (!(resendEmail instanceof HTMLInputElement)) return;
    setButtonBusy(resendButton instanceof HTMLButtonElement ? resendButton : null, true, 'Sending…');
    void resendSignup(locale, resendEmail.value.trim(), resendButton instanceof HTMLButtonElement ? resendButton : null, message);
  });

  void verify();
</script>
